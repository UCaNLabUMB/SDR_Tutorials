options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: power_test_03
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Power Test with Filter
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: P_n
  id: variable
  parameters:
    comment: ''
    value: noise_amp**2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1936, 568.0]
    rotation: 0
    state: enabled
- name: P_n_filtered
  id: variable
  parameters:
    comment: ''
    value: noise_amp**2 * (2*f_width/samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2048, 568.0]
    rotation: 0
    state: enabled
- name: f_width
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,2,1,2
    label: Filter Width
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: 2.5e4
    step: 5e3
    stop: 2.5e5
    value: 5e4
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 16.0]
    rotation: 0
    state: true
- name: filter_select
  id: variable_qtgui_chooser
  parameters:
